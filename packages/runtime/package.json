{
  "name": "@xecms/admin-runtime",
  "version": "0.6.0",
  "description": "Runtime components for composed XeCMS admin applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkjang2000/XeCMS-Plugin-AppBuilder.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/mkjang2000/XeCMS-Plugin-AppBuilder#readme",
  "bugs": {
    "url": "https://github.com/mkjang2000/XeCMS-Plugin-AppBuilder/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/composed-geometry.d.ts",
      "default": "./dist/composed-geometry.js"
    }
  },
  "files": [
    "dist",
    "src/*.css",
    "!dist/**/*.test.*",
    "!dist/**/*.integration.test.*",
    "!dist/.tsbuildinfo"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@xecms/admin-apps": "workspace:*",
    "@xecms/ui": "0.6.0",
    "recharts": "3.10.1",
    "react-is": "19.2.8",
    "@xecms/app-builder-client": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
